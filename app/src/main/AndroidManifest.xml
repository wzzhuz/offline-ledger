<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        当前不声明 android.permission.INTERNET，因为现有功能无需联网，
        而不是因为它是一条形式禁令。2026-11-17 使用者澄清：红线是
        「默认把账本数据回传厂商服务器且用户无法控制」；权限在手里即可。
        将来如需联网能力，SHALL 先在 openspec/project.md 写权限显式授权
        （用途 / 数据流向 / 用户控制方式），check_manifest_privacy.py 再放行。
        也刻意不声明 READ/WRITE_EXTERNAL_STORAGE：导入导出走 Storage Access Framework。
        依据：openspec/specs/privacy-security/spec.md 与 project.md 第一条铁律。
        自动化检查：scripts/check_manifest_privacy.py
    -->

    <!-- USE_BIOMETRIC 是 normal 级权限，不弹运行时权限框；
         仅用于 BiometricPrompt。SAF 与数据库加密都不需要任何权限。 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".OfflineLedgerApp"
        android:hasFragileUserData="true"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OfflineLedger">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OfflineLedger">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 静态 App Shortcut：framework 能力，不申请任何权限、不新增依赖。 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 第三批：趋势图全屏横屏页，仅内部调用，不导出、不新增权限。 -->
        <activity
            android:name=".ui.charts.ChartFullscreenActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.OfflineLedger" />
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        刻意不声明 android.permission.INTERNET。
        也刻意不声明 READ/WRITE_EXTERNAL_STORAGE：导入导出走 Storage Access Framework。
        依据：openspec/specs/privacy-security/spec.md 与 project.md 第一条铁律。
        自动化检查：scripts/check_manifest_privacy.py
    -->

    <!-- USE_BIOMETRIC 是 normal 级权限，不弹运行时权限框；
         仅用于 BiometricPrompt。SAF 与数据库加密都不需要任何权限。 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".OfflineLedgerApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OfflineLedger">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OfflineLedger">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 静态 App Shortcut：framework 能力，不申请任何权限、不新增依赖。 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>

</manifest>
